# The editor's assets as C arrays: cmake -DFONT=... -DLOGO=... -DOUT=... -P embed.cmake
function(embed file name out)
  file(READ "${file}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" body "${body}")
  file(APPEND "${out}" "extern const unsigned char ${name}Data[] = {\n${body}\n};\nextern const unsigned int ${name}Size = ${bytes};\n")
endfunction()
file(WRITE "${OUT}" "// generated by src/editor/embed.cmake: the editor's font (DM Sans, OFL) and logo\nnamespace awva_editor {\n")
embed("${FONT}" kFont "${OUT}")
embed("${LOGO}" kLogo "${OUT}")
file(APPEND "${OUT}" "} // namespace awva_editor\n")
