#
# The bench table (OUT/table.md) from every engine's OUT/<engine>.txt (bench.cmake): the CPU load
# of 1, 4 and the plugin's voices in the bare component and in each format, and the latency. The
# check (the regression check CI runs), at the plugin's voices: every format under 25 % of one
# core, and at most twice the bare component's load plus 0.5 % (the wrapper's own cost; the margin
# is for a shared runner's noise); an exit with an error if not.
# -DOUT -DENGINES=a,b,c
string(REPLACE "," ";" engines "${ENGINES}")
set(formats component clap vst3 au)
set(have_au FALSE)
set(cpu "")
set(lat "")
set(problems "")
function(hundredths value out) # "1.45" -> 145
  if(NOT value MATCHES "^([0-9]+)\\.([0-9][0-9])$")
    message(FATAL_ERROR "bench_table.cmake: not a load: ${value}")
  endif()
  math(EXPR v "${CMAKE_MATCH_1} * 100 + ${CMAKE_MATCH_2}")
  set(${out} ${v} PARENT_SCOPE)
endfunction()
foreach(e IN LISTS engines)
  file(STRINGS "${OUT}/${e}.txt" lines)
  set(row "| ${e} |")
  foreach(f IN LISTS formats)
    set(cell "")
    foreach(l IN LISTS lines)
      if(l MATCHES "^bench ${f} ([0-9]+) ([0-9.]+)$")
        if(cell)
          string(APPEND cell " / ")
        endif()
        string(APPEND cell "${CMAKE_MATCH_2}")
        set(last_${f} "${CMAKE_MATCH_2}")
      endif()
    endforeach()
    if(f STREQUAL "au" AND cell)
      set(have_au TRUE)
    endif()
    if(NOT f STREQUAL "au" OR have_au)
      string(APPEND row " ${cell} |")
    endif()
  endforeach()
  string(APPEND cpu "${row}\n")
  hundredths("${last_component}" c)
  foreach(f IN ITEMS clap vst3 au)
    if(f STREQUAL "au" AND NOT have_au)
      continue()
    endif()
    hundredths("${last_${f}}" x)
    math(EXPR limit "2 * ${c} + 50")
    if(x GREATER 2500 OR x GREATER limit)
      string(APPEND problems "  ${e} ${f}: ${last_${f}} % (the component ${last_component} %)\n")
    endif()
  endforeach()
  set(row "| ${e} |")
  foreach(l IN LISTS lines)
    if(l MATCHES "^latency ([a-z0-9]+) ([0-9a-z]+) (-?[0-9]+) (-?[0-9]+)$")
      string(APPEND row " ${CMAKE_MATCH_2}; ${CMAKE_MATCH_3} to ${CMAKE_MATCH_4} frames |")
    endif()
  endforeach()
  string(APPEND lat "${row}\n")
endforeach()
if(have_au)
  set(cpu_head "| engine | component | CLAP | VST3 | AU |\n|---|---|---|---|---|\n")
  set(lat_head "| engine | CLAP | VST3 | AU |\n|---|---|---|---|\n")
else()
  set(cpu_head "| engine | component | CLAP | VST3 |\n|---|---|---|---|\n")
  set(lat_head "| engine | CLAP | VST3 |\n|---|---|---|\n")
endif()
file(WRITE "${OUT}/table.md" "CPU load, % of one core at 48 kHz in host blocks of 128 (1 / 4 / 10 voices):\n\n${cpu_head}${cpu}\nLatency (reported; from a Note On to the first sample that isn't 0, over 20 phases of the 2 ms step):\n\n${lat_head}${lat}")
file(READ "${OUT}/table.md" t)
message("${t}")
if(problems)
  message(FATAL_ERROR "bench: over the limits (25 % of one core, twice the component's load + 0.5 %):\n${problems}")
endif()
